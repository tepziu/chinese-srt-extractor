# Runtime secrets
TELEGRAM_BOT_TOKEN=
AI_TRANSLATE_BASE_URL=http://127.0.0.1:8317/v1
AI_TRANSLATE_API_KEY=
AI_TRANSLATE_MODEL=gemini-3.8-flash-high
GEMINI_MODEL=gemini-3.8-flash-high
GEMINI_API_KEY=
GOOGLE_MEDIA_API_KEY=

# Local server
WEB_HOST=127.0.0.1
WEB_PORT=5000
# Cold CUDA/antivirus startup can take longer on Windows
WEB_START_TIMEOUT_SECONDS=90
BOT_START_TIMEOUT_SECONDS=30
ALLOW_SHUTDOWN=0
# 0 = khong gioi han dung luong
MAX_UPLOAD_BYTES=0
MAX_DOWNLOAD_BYTES=0
MAX_VIDEO_DURATION_SECONDS=0

# Cleanup
JOB_MAX_AGE_SECONDS=3600
JOB_MAX_COUNT=50
# Upload tam: 24 gio; output thanh pham: 30 ngay
FILE_MAX_AGE_SECONDS=86400
UPLOAD_FILE_MAX_AGE_SECONDS=86400
OUTPUT_FILE_MAX_AGE_SECONDS=2592000
CLEANUP_INTERVAL_SECONDS=1800

# Optional OmniVoice external runtime
OMNIVOICE_PYTHON=D:\Naldo\omnivoice-env\Scripts\python.exe
OMNIVOICE_REFERENCE_AUDIO=
OMNIVOICE_REFERENCE_TEXT_FILE=

# Shared local job snapshots and process locks (default: ./runtime)
# STUDIO_RUNTIME_DIR=D:\path\to\shared-runtime
STUDIO_MAX_PENDING_JOBS=16
DOUYIN_BACKFILL_HOURS=72
MAX_CONCURRENT_GPU_TASKS=1

# Gioi han dung luong moi doan clip gui OCR qua gateway (byte). 0 = khong gioi han
OCR_MAX_CLIP_BYTES=36700160

# Douyin Master downloader (refresh these values together from an authenticated session)
DY_COOKIES=
DY_TICKET=
DY_TS_SIGN=
DY_CLIENT_CERT=
DY_PRIVATE_KEY=
# 0 = strict Master API only; 1 = allow lower-confidence Chrome fallback
DOUYIN_BROWSER_FALLBACK=0
# Batch dịch toàn bộ thư mục video (đường dẫn phân cách bằng dấu ; trên Windows)
# Để trống khi chạy local và muốn cho phép chọn mọi thư mục tuyệt đối.
BATCH_ALLOWED_ROOTS=
BATCH_MAX_FILES=500

# Optional cross-project publish outbox. Rights must be explicitly approved.
DOUYIN_TIKTOK_OUTBOX_DIR=D:\Naldo\Tools\Douyin_TikTok_Spider\datas\content_inbox
DOUYIN_TIKTOK_RIGHTS_STATUS=review_required
